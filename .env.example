# Copie para .env.local. Para o ambiente local, rode `npm run env:local`
# (com o Supabase local no ar) que este arquivo é gerado automaticamente.

# URL da API do Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable/anon) do Supabase — segura para o navegador
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexão direta com o Postgres, usada só no servidor (Drizzle)
# local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# nuvem/Vercel: use a string do pooler (Transaction mode, porta 6543)
DATABASE_URL=
